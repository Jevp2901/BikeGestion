# Configuración general de Django
DEBUG=False
SECRET_KEY=tu_secret_key_segura_generada_aqui
ALLOWED_HOSTS=bikegestion-api.onrender.com,localhost,127.0.0.1

# Cadena de Conexión de Base de Datos PostgreSQL (Neon / Supabase)
# Ejemplo: postgres://usuario:password@ep-cool-flower-123456.us-east-2.aws.neon.tech/bikegestion?sslmode=require
DATABASE_URL=postgres://usuario:password@host_neon.tech/bikegestion?sslmode=require

# Configuración de CORS y Frontend
CORS_ALLOWED_ORIGINS=https://bikegestion.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://bikegestion.vercel.app,http://localhost:5173
FRONTEND_URL=https://bikegestion.vercel.app

# Configuración opcional de Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=tu_contrasena_de_aplicacion
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@bikegestion.local
